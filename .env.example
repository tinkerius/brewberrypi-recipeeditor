# Google settings for the dev server (README, Development). Copy this file to .env.local (git-ignored) and fill in
# the values from docs/google-setup.md §4: the same public values as the GitHub repository variables GOOGLE_CLIENT_ID,
# GOOGLE_API_KEY and GOOGLE_APP_ID. Restart `npm run dev` afterwards; Vite reads the file only when it starts.
# Left empty, the editor works signed out and the sign-in button is disabled.
# Sign in at http://localhost:5173 (the origin registered with Google), not by IP address. Signed in, the dev server
# works on your real Drive folder BrewberryPi/recipes, which BrewberryPi's Cloud Sync reads.

# OAuth client ID (Google Auth Platform → Clients), ends in .apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=
# API key for the Google Picker (APIs & Services → Credentials)
VITE_GOOGLE_API_KEY=
# Google Cloud project number (IAM & Admin → Settings)
VITE_GOOGLE_APP_ID=
